{
  "version": 1,
  "scenarios": [
    "arena-hard-greta",
    "arena-normal-greta",
    "dome-hard-tucker",
    "dome-normal-tucker",
    "factory-hard-noland",
    "factory-hard-setup",
    "factory-normal-noland",
    "palace-hard-spenser",
    "palace-normal-spenser",
    "pike-hard-lucy",
    "pike-normal-lucy",
    "pyramid-hard-brandon",
    "pyramid-normal-brandon",
    "tower-hard-anabel",
    "tower-normal-anabel"
  ],
  "rules": [
    {
      "name": "E2E infrastructure",
      "paths": ["Makefile", ".github/workflows/test*.yml", "tests/e2e_manifest.json", "tools/testing/run_e2e.py", "tools/testing/e2e/**", "src/e2e_fixture.c"],
      "scenarios": "all"
    },
    {
      "name": "Battle Tower",
      "paths": ["src/battle_tower.c", "include/battle_tower.h", "include/constants/battle_tower.h", "asm/macros/battle_frontier/battle_tower.inc", "data/maps/BattleFrontier_BattleTower*/**"],
      "scenarios": "all"
    },
    {
      "name": "Battle Factory",
      "paths": ["src/battle_factory*.c", "include/battle_factory*.h", "include/constants/battle_factory.h", "asm/macros/battle_frontier/battle_factory.inc", "data/maps/BattleFrontier_BattleFactory*/**"],
      "scenarios": ["factory-hard-noland", "factory-hard-setup", "factory-normal-noland"]
    },
    {
      "name": "Battle Dome",
      "paths": ["src/battle_dome.c", "include/battle_dome.h", "include/constants/battle_dome.h", "asm/macros/battle_frontier/battle_dome.inc", "data/maps/BattleFrontier_BattleDome*/**"],
      "scenarios": ["dome-hard-tucker", "dome-normal-tucker"]
    },
    {
      "name": "Battle Arena",
      "paths": ["src/battle_arena.c", "include/battle_arena.h", "include/constants/battle_arena.h", "asm/macros/battle_frontier/battle_arena.inc", "data/maps/BattleFrontier_BattleArena*/**"],
      "scenarios": ["arena-hard-greta", "arena-normal-greta"]
    },
    {
      "name": "Battle Palace",
      "paths": ["src/battle_palace.c", "include/battle_palace.h", "include/constants/battle_palace.h", "asm/macros/battle_frontier/battle_palace.inc", "data/maps/BattleFrontier_BattlePalace*/**"],
      "scenarios": ["palace-hard-spenser", "palace-normal-spenser"]
    },
    {
      "name": "Battle Pike",
      "paths": ["src/battle_pike.c", "include/battle_pike.h", "include/constants/battle_pike.h", "asm/macros/battle_frontier/battle_pike.inc", "data/maps/BattleFrontier_BattlePike*/**"],
      "scenarios": ["pike-hard-lucy", "pike-normal-lucy"]
    },
    {
      "name": "Battle Pyramid",
      "paths": ["src/battle_pyramid*.c", "data/maps/BattleFrontier_BattlePyramid*/**"],
      "scenarios": ["pyramid-hard-brandon", "pyramid-normal-brandon"]
    },
    {
      "name": "uncovered named flows",
      "paths": ["src/team_lab*.c", "include/team_lab.h", "src/frontier_intro_tutorial.c", "include/frontier_intro_tutorial.h"],
      "scenarios": []
    }
  ],
  "relevant_paths": ["src/**", "include/**", "data/**", "asm/**", "tools/testing/**", ".github/workflows/test*.yml", "Makefile"],
  "ignored_paths": ["*.md", "docs/**", "plans/**", "README*", "LICENSE*", ".gitignore", ".gitattributes", "tests/manifest.json"]
}
